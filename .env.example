# RentWork Environment Configuration

# Supabase Public Configuration (Exposed to Client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Private Configuration (Server-Side Only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application URL
APP_URL=http://localhost:3000

# Resend Transactional Email (Server-Side Only)
RESEND_API_KEY=re_your_resend_api_key_here

# Razorpay Payment Gateway (Server-Side Only)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Optional AI Features / Gemini API Key
GEMINI_API_KEY=
